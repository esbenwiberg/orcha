{
  "name": "@esbenwiberg/orcha",
  "version": "0.1.0",
  "description": "Parallel AI session orchestrator with real-time status visibility",
  "type": "module",
  "main": "dist/core/index.js",
  "bin": {
    "orcha": "./bin/orcha.js",
    "orcha-mcp": "./bin/orcha-mcp.js"
  },
  "files": [
    "bin/",
    "dist/",
    "src/web/public/",
    "prompts/",
    "scripts/install-defaults.js",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "ai",
    "claude",
    "orchestrator",
    "parallel",
    "tmux",
    "cli",
    "worktree",
    "git",
    "coding-assistant",
    "automation"
  ],
  "author": "Esben Wiberg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/esbenwiberg/orcha.git"
  },
  "bugs": {
    "url": "https://github.com/esbenwiberg/orcha/issues"
  },
  "homepage": "https://github.com/esbenwiberg/orcha#readme",
  "scripts": {
    "build": "tsc && npm run copy-public",
    "copy-public": "cp -r src/web/public dist/web/",
    "dev": "tsc --watch",
    "test": "vitest",
    "lint": "eslint src/",
    "start": "node dist/cli/index.js",
    "web": "node dist/web/start-server.js",
    "web:dev": "PORT=3000 NO_OPEN=1 node dist/web/start-server.js",
    "prepublishOnly": "npm run build",
    "postinstall": "node scripts/install-defaults.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@types/blessed": "^0.1.27",
    "@types/express": "^5.0.6",
    "@types/ws": "^8.18.1",
    "blessed": "^0.1.81",
    "chalk": "^5.3.0",
    "chokidar": "^3.6.0",
    "commander": "^12.1.0",
    "express": "^5.2.1",
    "express-openid-connect": "^2.19.4",
    "handlebars": "^4.7.8",
    "ink": "^6.6.0",
    "ink-box": "^1.0.0",
    "js-yaml": "^4.1.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.4",
    "simple-git": "^3.27.0",
    "tar": "^7.4.3",
    "tree-kill": "^1.2.2",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.17.0",
    "@types/react": "^19.2.10",
    "@types/tar": "^6.1.13",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
